# MZC Sales Radar - 환경변수
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
S3_BUCKET_NAME=mzc-sales-radar-bucket
DYNAMODB_TABLE_NAME=mzc-sales-radar
USE_AWS_STORAGE=true

# Bedrock Knowledge Bases (RAG) - KB 생성 후 ID 입력
BEDROCK_KB_ID=

# Bedrock Guardrails - Guardrail 생성 후 ID 입력
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# CloudWatch
CLOUDWATCH_LOG_GROUP=/mzc-sales-radar/agents
